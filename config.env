# AI-Workbench Core v1.0 — config.env
#
# Every install.sh/service toggle lives here so re-runs are declarative:
# flip a flag, re-run `awb install`, and only that section executes again
# (see lib/utils.sh:is_true and the selective re-execution principle in
# docs/PRINCIPLES.md).

# -----------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------
AI_HOME=$HOME/ai

# -----------------------------------------------------------------------
# Runtimes
# -----------------------------------------------------------------------
INSTALL_LLAMACPP=true
INSTALL_LLAMACPP_SERVICE=true
INSTALL_OLLAMA=true
INSTALL_OPENVINO=false
INSTALL_ONNXRUNTIME=false
INSTALL_WHISPER=true

# Python 'speech' venv (openai-whisper + soundfile). Off by default: it pulls
# torch, triton and 4 nvidia CUDA runtime packages (~730MB of wheels before
# those) and nothing in AI-Workbench uses it — the supported speech path is
# whisper.cpp (INSTALL_WHISPER above). Enable if you want the Python stack
# for fine-tuning or research.
INSTALL_SPEECH_VENV=false

# -----------------------------------------------------------------------
# NVIDIA-only extras (ignored on other platforms)
# -----------------------------------------------------------------------
INSTALL_TENSORRT=true

# -----------------------------------------------------------------------
# Services (Docker Compose)
# -----------------------------------------------------------------------
INSTALL_DOCKER=true
INSTALL_OPENWEBUI=true
INSTALL_QDRANT=true
INSTALL_CHROMADB=true
INSTALL_POSTGRES=true

# Qdrant, ChromaDB and Postgres have no (or, for Postgres, weak default)
# authentication out of the box, so they're bound to localhost only unless
# you deliberately need another machine to reach them. Open WebUI is
# excluded on purpose — it's the intended LAN-facing entry point. Set to
# 0.0.0.0 to expose these on the network (do this only after changing the
# change-me secrets below).
SERVICES_BIND_HOST=127.0.0.1

OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=IaCBzg1q7rfSLNbsD1Rn+d4pXSVH4dmJYWpNEOs1OMxTaZHAGCtNRIGtuBNuMmic4wPzP6MiZiDcvfnP43+yvw==
OLLAMA_BASE_URL=http://host.docker.internal:11434

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

CHROMADB_PORT=8000

POSTGRES_USER=awb
POSTGRES_PASSWORD=CUR493qKBitJRL3aFBN2
POSTGRES_DB=awb
POSTGRES_PORT=5432

# -----------------------------------------------------------------------
# Default model
# -----------------------------------------------------------------------
# Used by runtimes/llama.cpp/install.sh's systemd unit as a sane default.
DEFAULT_MODEL=gemma4-e2b
AWB_DEFAULT_GGUF=gemma-4-E2B-it-Q8_0.gguf

# GGML speech model fetched when INSTALL_WHISPER is on. whisper.cpp builds a
# binary that cannot do anything without one of these, and benchmarks/whisper
# expects base.en specifically. Set empty to build whisper.cpp without a model.
DEFAULT_WHISPER_MODEL=whisper-base.en

# -----------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------
# Symlink scripts/awb into AWB_CLI_DIR so `awb ...` works from any directory.
# The link points at the repo, so `git pull` updates the command in place.
INSTALL_AWB_CLI=true
AWB_CLI_DIR=$HOME/.local/bin

# -----------------------------------------------------------------------
# Validation thresholds
# -----------------------------------------------------------------------
MIN_DISK_GB=20
MIN_RAM_GB=8
