# AI-Workbench Core v1.0 — config.env
#
# Every install.sh/service toggle lives here so re-runs are declarative:
# flip a flag, re-run `awb install`, and only that section executes again
# (see lib/utils.sh:is_true and the selective re-execution principle in
# docs/PRINCIPLES.md).

# -----------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------
AI_HOME=$HOME/ai

# -----------------------------------------------------------------------
# Runtimes
# -----------------------------------------------------------------------
INSTALL_LLAMACPP=true
INSTALL_LLAMACPP_SERVICE=true
INSTALL_OLLAMA=true
INSTALL_OPENVINO=true
INSTALL_ONNXRUNTIME=true
INSTALL_WHISPER=true

# -----------------------------------------------------------------------
# NVIDIA-only extras (ignored on other platforms)
# -----------------------------------------------------------------------
INSTALL_TENSORRT=false

# -----------------------------------------------------------------------
# Services (Docker Compose)
# -----------------------------------------------------------------------
INSTALL_DOCKER=true
INSTALL_OPENWEBUI=true
INSTALL_QDRANT=false
INSTALL_CHROMADB=false
INSTALL_POSTGRES=false

OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me
OLLAMA_BASE_URL=http://host.docker.internal:11434

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

CHROMADB_PORT=8000

POSTGRES_USER=awb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=awb
POSTGRES_PORT=5432

# -----------------------------------------------------------------------
# Default model
# -----------------------------------------------------------------------
# Used by runtimes/llama.cpp/install.sh's systemd unit as a sane default.
DEFAULT_MODEL=gemma3-e2b
AWB_DEFAULT_GGUF=gemma-3n-E2B-it-Q8_0.gguf

# -----------------------------------------------------------------------
# Validation thresholds
# -----------------------------------------------------------------------
MIN_DISK_GB=20
MIN_RAM_GB=8
