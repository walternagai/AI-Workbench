# AI-Workbench Core v1.0 — config.env
#
# Every install.sh/service toggle lives here so re-runs are declarative:
# flip a flag, re-run `awb install`, and only that section executes again
# (see lib/utils.sh:is_true and the selective re-execution principle in
# docs/PRINCIPLES.md).

# -----------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------
AI_HOME=$HOME/ai

# -----------------------------------------------------------------------
# Runtimes
# -----------------------------------------------------------------------
INSTALL_LLAMACPP=true
INSTALL_LLAMACPP_SERVICE=true
INSTALL_OLLAMA=true
INSTALL_OPENVINO=false
INSTALL_ONNXRUNTIME=false
INSTALL_WHISPER=true

# Python 'speech' venv (openai-whisper + soundfile). Off by default: it pulls
# torch, triton and 4 nvidia CUDA runtime packages (~730MB of wheels before
# those) and nothing in AI-Workbench uses it — the supported speech path is
# whisper.cpp (INSTALL_WHISPER above). Enable if you want the Python stack
# for fine-tuning or research.
INSTALL_SPEECH_VENV=false

# -----------------------------------------------------------------------
# NVIDIA-only extras (ignored on other platforms)
# -----------------------------------------------------------------------
INSTALL_TENSORRT=true

# -----------------------------------------------------------------------
# Services (Docker Compose)
# -----------------------------------------------------------------------
INSTALL_DOCKER=true

# Defaults públicos: nenhum serviço ligado. Quem usa um serviço liga a flag em
# config.local.env (gitignored; ver config.local.env.example). Assim o config.env
# versionado não depende da rede, da GPU ou da imagem de uma máquina específica.
INSTALL_OPENWEBUI=false
INSTALL_QDRANT=false
INSTALL_CHROMADB=false
INSTALL_POSTGRES=false
INSTALL_COMFYUI=false

# Bind de cada serviço (ver o comentário no compose de cada um):
#   Qdrant   -> 172.17.0.1 (gateway docker0; alcançável por containers, não pela LAN)
#   ComfyUI  -> 172.17.0.1 (idem; o Seiryu chega por host.docker.internal)
#   ChromaDB e Postgres -> SERVICES_BIND_HOST (127.0.0.1 por padrão)
#   Open WebUI -> todas as interfaces: é o ponto de entrada da LAN.
# Qdrant, ChromaDB e Postgres não têm autenticação por padrão (Postgres tem uma
# senha fraca de fábrica), por isso só saem do localhost por escolha explícita.
# Só troque SERVICES_BIND_HOST por 0.0.0.0 depois de trocar os segredos abaixo.
SERVICES_BIND_HOST=127.0.0.1

# Pré-requisitos de serviços específicos. Valores pessoais: definir em config.local.env.
# COMFYUI_GPU_UUID: UUID da GPU dedicada (nvidia-smi -L). Obrigatório se INSTALL_COMFYUI=true.
COMFYUI_GPU_UUID=
# Rede Docker externa do hub Seiryu, usada pelo ChromaDB. Vazia = o ChromaDB é
# pulado com aviso quando INSTALL_CHROMADB=true.
CHROMADB_EXTERNAL_NETWORK=

OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me
OLLAMA_BASE_URL=http://host.docker.internal:11434

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

CHROMADB_PORT=8000

POSTGRES_USER=awb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=awb
POSTGRES_PORT=5432

# ComfyUI (geração de imagens local — backend do Kage no Seiryu).
# A GPU é escolhida em COMFYUI_GPU_UUID (config.local.env). Publicado só no
# gateway docker0 (172.17.0.1): o Seiryu alcança via host.docker.internal:7860.
COMFYUI_PORT=7860
# Imagem construída localmente por services/comfyui/Dockerfile. Não vem de registry.
COMFYUI_IMAGE=seiryu/comfyui:0.43.2-cu128-restore

# -----------------------------------------------------------------------
# Default model
# -----------------------------------------------------------------------
# Used by runtimes/llama.cpp/install.sh's systemd unit as a sane default.
DEFAULT_MODEL=gemma4-e2b
AWB_DEFAULT_GGUF=gemma-4-E2B-it-Q8_0.gguf

# GGML speech model fetched when INSTALL_WHISPER is on. whisper.cpp builds a
# binary that cannot do anything without one of these, and benchmarks/whisper
# expects base.en specifically. Set empty to build whisper.cpp without a model.
DEFAULT_WHISPER_MODEL=whisper-base.en

# -----------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------
# Symlink scripts/awb into AWB_CLI_DIR so `awb ...` works from any directory.
# The link points at the repo, so `git pull` updates the command in place.
INSTALL_AWB_CLI=true
AWB_CLI_DIR=$HOME/.local/bin

# -----------------------------------------------------------------------
# Validation thresholds
# -----------------------------------------------------------------------
MIN_DISK_GB=20
MIN_RAM_GB=8
