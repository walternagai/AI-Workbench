#!/usr/bin/env bash
# scripts/awb — AI-Workbench CLI entrypoint.
#
# Usage:
#   awb install                      Run the full installer
#   awb doctor                       Run diagnostics
#   awb detect                       Print hardware detection summary
#   awb update                       Update AI-Workbench + installed components
#   awb monitor                      Live resource snapshot (CPU/GPU/mem/temp)
#   awb info                         Show version + hardware summary
#   awb model install <name>         Install a model from the catalog
#   awb model install custom <repo> <file>
#   awb model list                   List the model catalog
#   awb model remove <filename>      Remove a downloaded model
#   awb model update                 Show installed models / update guidance
#   awb runtime install <name>       Install a runtime (llama.cpp|ollama|openvino|onnxruntime|whisper)
#   awb runtime update <name>
#   awb runtime remove <name>
#   awb benchmark <llm|whisper|vision|embeddings> [args...]
set -euo pipefail

# Resolve through symlinks before deriving AWB_ROOT. This script is meant to be
# linked into a PATH directory (ln -s .../scripts/awb ~/.local/bin/awb), and
# BASH_SOURCE[0] is the symlink's own path, not its target — so a plain dirname
# puts AWB_ROOT in ~/.local and every source below fails on a missing lib/.
AWB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export AWB_ROOT

# shellcheck source=lib/colors.sh
source "${AWB_ROOT}/lib/colors.sh"
# shellcheck source=lib/logger.sh
source "${AWB_ROOT}/lib/logger.sh"
# shellcheck source=lib/utils.sh
source "${AWB_ROOT}/lib/utils.sh"
# shellcheck source=lib/downloader.sh
source "${AWB_ROOT}/lib/downloader.sh"

load_env "${AWB_ROOT}/config.env" false

# Print the header comment block (everything after the shebang up to the first
# non-comment line) as the usage text. Deriving the end of the block instead of
# hardcoding a line number keeps `set -euo pipefail` — and anything else added
# below the header — out of the help output.
_usage() {
    awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' \
        "$(readlink -f "${BASH_SOURCE[0]}")"
}

_need_detection() {
    safe_source "${AWB_ROOT}/detect.sh"
    declare -F run_all_detections &>/dev/null || fail_loud "detect.sh loaded but run_all_detections() not found"
    declare -F resolve_platform_target &>/dev/null || fail_loud "detect.sh loaded but resolve_platform_target() not found"
    run_all_detections
    resolve_platform_target
}

cmd="${1:-}"; shift || true

case "$cmd" in
    install)
        exec "${AWB_ROOT}/install.sh" "$@"
        ;;
    doctor)
        exec "${AWB_ROOT}/doctor.sh" "$@"
        ;;
    detect)
        exec "${AWB_ROOT}/detect.sh"
        ;;
    update)
        exec "${AWB_ROOT}/update.sh" "$@"
        ;;
    monitor)
        _need_detection
        safe_source "${AWB_ROOT}/monitoring/cpu.sh"
        safe_source "${AWB_ROOT}/monitoring/memory.sh"
        safe_source "${AWB_ROOT}/monitoring/gpu.sh"
        safe_source "${AWB_ROOT}/monitoring/temperature.sh"
        monitor_cpu; echo; monitor_memory; echo; monitor_gpu; echo; monitor_temperature
        ;;
    info)
        _need_detection
        echo -e "${C_BOLD}AI-Workbench Core v1.0${C_RESET}"
        print_summary
        ;;
    model)
        safe_source "${AWB_ROOT}/models/install.sh"
        safe_source "${AWB_ROOT}/models/update.sh"
        sub="${1:-}"; shift || true
        case "$sub" in
            install) model_install "$@" ;;
            list)    model_catalog_list ;;
            remove)  model_remove "$@" ;;
            update)  model_update_all ;;
            *) log_error "Usage: awb model {install|list|remove|update}"; exit 1 ;;
        esac
        ;;
    runtime)
        _need_detection
        sub="${1:-}"; rt="${2:-}"; shift 2 || true
        # Security: validate runtime name to prevent path traversal
        [[ -n "$rt" ]] || { log_error "Usage: awb runtime {install|update|remove} <name>"; exit 1; }
        [[ "$rt" =~ ^[a-zA-Z0-9._-]+$ ]] || { log_error "Invalid runtime name: ${rt} (use only letters, digits, dots, hyphens, underscores)"; exit 1; }
        safe_source "${AWB_ROOT}/runtimes/${rt}/install.sh"
        case "$sub" in
            install|update|remove) ;;
            *) log_error "Usage: awb runtime {install|update|remove} <name>"; exit 1 ;;
        esac
        fn="${sub}_${rt//./_}"
        declare -F "$fn" >/dev/null \
            || fail_loud "Runtime '${rt}' does not implement '${sub}' (no ${fn}() function)."
        "$fn" "$@"
        ;;
    benchmark)
        _need_detection
        target="${1:-}"; shift || true
        [[ -n "$target" ]] || { log_error "Usage: awb benchmark <llm|whisper|vision|embeddings> [args...]"; exit 1; }
        [[ "$target" =~ ^[a-z]+$ ]] || { log_error "Invalid benchmark target: ${target}"; exit 1; }
        safe_source "${AWB_ROOT}/benchmarks/${target}/run.sh"
        "benchmark_${target}" "$@"
        ;;
    -h|--help|help|"")
        _usage
        ;;
    *)
        log_error "Unknown command: $cmd"
        _usage
        exit 1
        ;;
esac
