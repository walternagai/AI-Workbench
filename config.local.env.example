# config.local.env.example — copy to config.local.env and fill in.
#
# config.local.env is gitignored and is loaded after config.env, so anything
# set here overrides the tracked defaults. This is where secrets belong:
# config.env is committed, so a real key written there is published.
#
# Generate a strong value with:  openssl rand -hex 32

WEBUI_SECRET_KEY=
#POSTGRES_PASSWORD=
