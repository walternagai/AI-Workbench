# config.local.env.example — copy to config.local.env and fill in.
#
# config.local.env is gitignored and is loaded after config.env, so anything
# set here overrides the tracked defaults. This is where secrets belong:
# config.env is committed, so a real key written there is published.
#
# The file must be mode 600 and owned by you (chmod 600 config.local.env) or
# the installer refuses to load it. Services refuse to start while a secret
# is still the "change-me" placeholder from config.env.
#
# Generate a strong value with:  openssl rand -hex 32

WEBUI_SECRET_KEY=
#POSTGRES_PASSWORD=

# Optional: fingerprint of the key that signs Intel's NPU driver .deb files
# (import the key into your gpg keyring first). When set, the NPU driver is
# only installed if every .deb carries a valid signature from this key.
#AWB_NPU_GPG_FINGERPRINT=
